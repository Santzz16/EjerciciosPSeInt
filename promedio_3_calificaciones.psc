Algoritmo promedio_3_calificaciones
	Definir c1, c2, c3, p Como Entero;
	
	Escribir "Ingrese calificacion 1: ";
	Leer c1;
	
	Escribir  "INgrese calificacion 2: ";
	Leer c2;
	
	Escribir "Ingrese calificacion 3";
	Leer c3;
	
	p = (c1 + c2 + c3)/3
	
	EScribir "El promedio de las tres calificaciones es: ", p, "."
	
	
FinAlgoritmo
