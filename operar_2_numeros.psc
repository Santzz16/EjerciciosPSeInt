Algoritmo operar_2_numeros
	Definir a, b, s, r, m, d Como Real;

	Escribir "Ingresa el primer numero:";
	Leer a;
	
	Escribir "Ingresa el segundo numero:";
	Leer b;
	
	s = a + b;
	r = a - b;
	m = a * b;
	d = a/b;
	
	
	Escribir "El resultado de la suma es: ", s,".";
	Escribir "El resultado de la resta es: ", r,".";
	Escribir "El resultado de la multiplicación es: ", m,".";
	Escribir "El resultado de la divisin es: ", d,".";
	
FinAlgoritmo
